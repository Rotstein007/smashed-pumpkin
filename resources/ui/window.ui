                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="label" translatable="yes">Set hostnames for this server and optionally keep a Cloudflare DNS record updated when your home IP changes.</property>
                                            <property name="wrap">true</property>
