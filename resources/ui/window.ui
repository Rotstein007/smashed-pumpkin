                                          <object class="AdwComboRow" id="row_language">
                                            <property name="title" translatable="yes">Language</property>
                                            <property name="subtitle" translatable="yes">Save to apply on the next application launch. Missing translations use English.</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="AdwActionRow" id="row_language_restart">
                                            <property name="visible">false</property>
                                            <property name="title" translatable="yes">Language change saved</property>
                                            <property name="subtitle" translatable="yes">The new language will be used next time you launch the application. Running servers are not restarted.</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="AdwActionRow">
                                            <property name="title" translatable="yes">Date format</property>
                                            <property name="subtitle" translatable="yes">Used in logs, player information and build labels.</property>
                                            <property name="activatable-widget">drop_date_format</property>
                                            <child type="suffix">
                                              <object class="GtkDropDown" id="drop_date_format">
                                                <property name="valign">center</property>
                                                <property name="model">
                                                  <object class="GtkStringList">
                                                    <items>
                                                      <item translatable="yes">YYYY-MM-DD</item>
                                                      <item translatable="yes">DD.MM.YYYY</item>
                                                      <item translatable="yes">MM/DD/YYYY</item>
                                                    </items>
                                                  </object>
                                                </property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="AdwActionRow">
                                            <property name="title" translatable="yes">Time format</property>
                                            <property name="subtitle" translatable="yes">Uses your local system timezone.</property>
                                            <property name="activatable-widget">drop_time_format</property>
                                            <child type="suffix">
                                              <object class="GtkDropDown" id="drop_time_format">
                                                <property name="valign">center</property>
                                                <property name="model">
                                                  <object class="GtkStringList">
                                                    <items>
                                                      <item translatable="yes">24-hour</item>
                                                      <item translatable="yes">12-hour</item>
                                                    </items>
                                                  </object>
                                                </property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwPreferencesGroup">
                                        <property name="title" translatable="yes">Server startup</property>
                                        <child>
                                          <object class="AdwActionRow">
                                            <property name="title" translatable="yes">Auto-start servers on launch</property>
                                            <property name="subtitle" translatable="yes">Start the selected servers after their configured delay.</property>
                                            <property name="activatable-widget">switch_auto_start_servers</property>
                                            <child type="suffix">
                                              <object class="GtkSwitch" id="switch_auto_start_servers">
                                                <property name="valign">center</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkListBox" id="autostart_server_list">
                                            <property name="selection-mode">none</property>
                                            <style>
                                              <class name="boxed-list"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton" id="btn_add_autostart_server">
                                            <property name="halign">start</property>
                                            <property name="tooltip-text" translatable="yes">Add server to auto-start list</property>
                                            <child>
                                              <object class="GtkBox">
                                                <property name="spacing">6</property>
                                                <child>
                                                  <object class="GtkLabel">
                                                    <property name="label" translatable="yes">Add server</property>
                                                  </object>
                                                </child>
                                                <child>
                                                  <object class="GtkImage">
                                                    <property name="icon-name">list-add-symbolic</property>
                                                  </object>
                                                </child>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwPreferencesGroup">
                                        <property name="title" translatable="yes">Background and overview</property>
                                        <child>
                                          <object class="AdwActionRow">
                                            <property name="title" translatable="yes">Keep running in background</property>
                                            <property name="subtitle" translatable="yes">Closing the window keeps the app and servers running.</property>
                                            <property name="activatable-widget">switch_run_in_background</property>
                                            <child type="suffix">
                                              <object class="GtkSwitch" id="switch_run_in_background">
                                                <property name="valign">center</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="AdwActionRow">
                                            <property name="title" translatable="yes">Show detailed server cards</property>
                                            <property name="subtitle" translatable="yes">Show build, players, size, ports and status in the overview.</property>
                                            <property name="activatable-widget">switch_detailed_overview_cards</property>
                                            <child type="suffix">
                                              <object class="GtkSwitch" id="switch_detailed_overview_cards">
                                                <property name="valign">center</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwPreferencesGroup" id="minimap_settings_group">
                                        <property name="title" translatable="yes">Minimap</property>
                                        <property name="description" translatable="yes">Optional world map and local player telemetry. Applies immediately.</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwPreferencesGroup">
                                        <property name="title" translatable="yes">Downloads and storage</property>
                                        <child>
                                          <object class="AdwComboRow" id="row_release_channel">
                                            <property name="title" translatable="yes">Pumpkin release channel</property>
                                            <property name="subtitle" translatable="yes">Applies to future installs and updates. Back up worlds before changing channels; plugin compatibility may differ.</property>
                                            <property name="model">
                                              <object class="GtkStringList">
                                                <items>
                                                  <item translatable="yes">Nightly</item>
                                                  <item translatable="yes">Stable</item>
                                                </items>
                                              </object>
                                            </property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="AdwActionRow">
                                            <property name="title" translatable="yes">Use local download cache</property>
                                            <property name="subtitle" translatable="yes">Reuse downloaded Pumpkin binaries across servers.</property>
                                            <property name="activatable-widget">switch_use_cache</property>
                                            <child type="suffix">
                                              <object class="GtkSwitch" id="switch_use_cache">
                                                <property name="valign">center</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="AdwActionRow">
                                            <property name="title" translatable="yes">Cached downloads</property>
                                            <property name="subtitle" translatable="yes">Installed servers are not removed.</property>
                                            <child type="suffix">
                                              <object class="GtkButton" id="btn_clear_cache">
                                                <property name="label" translatable="yes">Clear Cache</property>
                                                <property name="valign">center</property>
                                                <property name="tooltip-text" translatable="yes">Delete all cached Pumpkin binaries</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwPreferencesGroup">
                                        <property name="title" translatable="yes">Advanced</property>
                                        <child>
                                          <object class="AdwActionRow">
                                            <property name="title" translatable="yes">Download URL</property>
                                            <property name="subtitle" translatable="yes">Leave empty to use the selected release channel. Custom URLs override the channel and are not checked for updates.</property>
                                            <child type="suffix">
                                              <object class="GtkEntry" id="entry_download_url">
                                                <property name="valign">center</property>
                                                <property name="hexpand">true</property>
                                                <property name="placeholder-text" translatable="yes">Pumpkin download URL (binary)</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>

                                    <!-- General Save & Reset -->
                                    <child>
                                      <object class="GtkBox">
                                        <property name="spacing">8</property>
                                        <child>
                                          <object class="GtkButton" id="btn_save_general_settings">
                                            <property name="label" translatable="yes">Save Application Settings</property>
                                            <property name="css-classes">suggested-action</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton" id="btn_reset_general_settings">
                                            <property name="label" translatable="yes">Reset to Defaults</property>
                                            <property name="css-classes">destructive-action</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                              </object>
                                                </property>
                                              </object>
                                            </child>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwViewStackPage">
                                        <property name="name">server_settings</property>
                                        <property name="title" translatable="yes">Server</property>
                                        <property name="icon-name">network-server-symbolic</property>
                                        <property name="child">
                                          <object class="GtkScrolledWindow">
                                            <property name="vexpand">true</property>
                                            <child>
                                              <object class="AdwClamp">
                                                <property name="maximum-size">760</property>
                                                <property name="tightening-threshold">600</property>
                                                <property name="child">
                                              <object class="GtkBox">
                                                <property name="orientation">vertical</property>
                                                <property name="spacing">14</property>
                                                <property name="margin-top">12</property>
                                                <property name="margin-bottom">24</property>
                                                <property name="margin-start">12</property>
                                                <property name="margin-end">12</property>
                                                <style><class name="settings-content"/></style>

                                    <!-- ========== SERVER SETTINGS ========== -->
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">Server Settings</property>
                                        <property name="xalign">0</property>
                                        <style><class name="title-3"/></style>
                                      </object>
                                    </child>

                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">Identity &amp; Install</property>
                                        <property name="xalign">0</property>
                                        <style><class name="title-4"/></style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkEntry" id="entry_server_name">
                                        <property name="placeholder-text" translatable="yes">Server name (shown in the app)</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="spacing">8</property>
                                        <child>
                                          <object class="GtkButton" id="btn_choose_icon">
                                            <property name="label" translatable="yes">Choose Server Icon</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton" id="btn_reset_icon">
                                            <property name="label" translatable="yes">Reset Icon</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Minecraft uses a 64×64 PNG named server-icon.png in the server root. The image will be resized and saved there.</property>
                                    <property name="wrap">true</property>
                                    <property name="xalign">0</property>
                                    <style><class name="dim-label"/></style>
                                  </object>
                                </child>

                                    <child>
                                      <object class="GtkSeparator"/>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">Networking</property>
                                        <property name="xalign">0</property>
                                        <style><class name="title-4"/></style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="spacing">16</property>
